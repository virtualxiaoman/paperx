{
  "$defs": {
    "BBox": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "BBox",
      "type": "object"
    },
    "Block": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "heading",
            "paragraph",
            "formula",
            "figure",
            "table",
            "citation",
            "list",
            "code"
          ],
          "title": "Type",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "locations": {
          "items": {
            "$ref": "#/$defs/Location"
          },
          "title": "Locations",
          "type": "array"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "heading_level": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading Level"
        },
        "formula": {
          "anyOf": [
            {
              "$ref": "#/$defs/Formula"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "page",
        "order",
        "bbox",
        "source",
        "confidence"
      ],
      "title": "Block",
      "type": "object"
    },
    "Formula": {
      "additionalProperties": false,
      "properties": {
        "latex": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latex"
        },
        "number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "status": {
          "default": "unrecognized",
          "enum": [
            "unrecognized",
            "needs_review",
            "verified"
          ],
          "title": "Status",
          "type": "string"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "verified_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified By"
        }
      },
      "required": [
        "source",
        "confidence"
      ],
      "title": "Formula",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        }
      },
      "required": [
        "page",
        "bbox"
      ],
      "title": "Location",
      "type": "object"
    },
    "Page": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "rotation": {
          "default": 0,
          "enum": [
            0,
            90,
            180,
            270
          ],
          "title": "Rotation",
          "type": "integer"
        },
        "text_status": {
          "enum": [
            "available",
            "missing"
          ],
          "title": "Text Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "number",
        "width",
        "height",
        "text_status"
      ],
      "title": "Page",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "level": {
          "maximum": 6,
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "title": "Children",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "block_id",
        "level"
      ],
      "title": "Section",
      "type": "object"
    },
    "TranslationBlock": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source_block_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Block Ids",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "status": {
          "enum": [
            "translated",
            "preserved",
            "failed",
            "unmapped"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_block_ids",
        "text",
        "status"
      ],
      "title": "TranslationBlock",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "paper_id": {
      "title": "Paper Id",
      "type": "string"
    },
    "source_sha256": {
      "title": "Source Sha256",
      "type": "string"
    },
    "parser_version": {
      "title": "Parser Version",
      "type": "string"
    },
    "coordinate_system": {
      "const": "normalized-unrotated-mediabox-top-left",
      "default": "normalized-unrotated-mediabox-top-left",
      "title": "Coordinate System",
      "type": "string"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/Page"
      },
      "title": "Pages",
      "type": "array"
    },
    "blocks": {
      "items": {
        "$ref": "#/$defs/Block"
      },
      "title": "Blocks",
      "type": "array"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/Section"
      },
      "title": "Sections",
      "type": "array"
    },
    "translations": {
      "items": {
        "$ref": "#/$defs/TranslationBlock"
      },
      "title": "Translations",
      "type": "array"
    },
    "translation_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Translation Version"
    },
    "previous_parser_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Parser Version"
    },
    "previous_id_map": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Previous Id Map",
      "type": "object"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "paper_id",
    "source_sha256",
    "parser_version",
    "pages",
    "blocks"
  ],
  "title": "Document",
  "type": "object"
}
